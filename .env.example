# --- Authentication ---
# Required. Signs admin session JWTs and newsletter unsubscribe tokens.
# There is no fallback: the app refuses to sign or verify without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Database ---
# Required. Postgres connection string (Supabase or any Postgres host).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Admin User (used by the db:init / db:migration:admin scripts) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=your-email@example.com

# --- reCAPTCHA v3 (https://www.google.com/recaptcha/admin) ---
NUXT_RECAPTCHA_SECRET_KEY=your_v3_secret_key_here
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=your_v3_site_key_here
# Set to true to bypass reCAPTCHA verification during local development.
SKIP_RECAPTCHA=false

# --- Email ---
# When true, mail goes out through Resend; otherwise through SMTP below.
USE_RESEND=false
RESEND_API_KEY=
# SMTP is used for local development (defaults target Mailpit on 127.0.0.1:2525).
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
# Destination for contact form submissions.
CONTACT_EMAIL=borysbabas@pm.me

# --- GitHub ---
# Server-side only. Read by /api/github/repos to raise the API rate limit.
# Must NOT be prefixed with NUXT_PUBLIC_: that would expose it to the browser.
# A fine-grained token with public read access is sufficient.
GITHUB_TOKEN=

# --- Site ---
# Public base URL, used to build newsletter unsubscribe links.
NUXT_PUBLIC_SITE_URL=https://borysbabas.dev
